# Copy to .env (local) or host env vars.
# Supabase Postgres connection string (Settings -> Database -> Connection string).
DATABASE_URL=postgres://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require
# HMAC attempt-ticket secret; generate with: openssl rand -hex 32
APP_SECRET=
# Admin token for POST /api/admin/levels/import
ADMIN_TOKEN=
# Token for POST /api/cron/finalize
CRON_TOKEN=
PORT=3000
