rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Публично читаемые коллекции =====
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;   // только бэкенд (Admin SDK)
    }

    // ===== Прогресс игрока =====
    match /progress/{uid} {
      allow read, write: if false;  // только бэкенд (Admin SDK/Wallet через VK)
    }

    // ===== Конфиг ивента (читается клиентом, меняется только бэкендом) =====
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ===== Жизни (только бэкенд) =====
    match /lives/{uid} {
      allow read, write: if false;
    }

    // ===== События и всё под ними — только бэкенд =====
    match /events/{eventId} {
      allow read: if true;   // клиенту можно читать инфо/статус
      allow write: if false;
      match /players/{uid} {
        allow read: if true;
        allow write: if false;
      }
      match /attempts/{attemptId} {
        allow read, write: if false;
      }
      match /rewards/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ===== Fallback: всё остальное закрыто =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}